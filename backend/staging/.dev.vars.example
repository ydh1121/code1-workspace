# Isolated CODE1 STAGING only. Never populate or commit real values.
CODE1_RUNTIME_BACKEND=APPS_SCRIPT
CODE1_STAGING_PROJECT_REF=
CODE1_SUPABASE_URL=
CODE1_SUPABASE_SERVICE_ROLE_KEY=
CODE1_UPLOAD_TOKEN_SECRET=
